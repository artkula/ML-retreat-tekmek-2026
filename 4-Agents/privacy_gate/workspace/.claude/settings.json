{
  "permissions": {
    "allow": [
      "Bash(python privacy_gate.py clean originals clean)",
      "Bash(python privacy_gate.py restore clean/*)",
      "PowerShell(python privacy_gate.py clean originals clean)",
      "PowerShell(python privacy_gate.py restore clean/*)",
      "Read(clean/**)",
      "Edit(clean/**)"
    ],
    "deny": [
      "Read(originals/**)",
      "Edit(originals/**)",
      "Read(*_KEY.json)",
      "Read(clean_restored/**)",
      "Bash(cat *)", "Bash(type *)", "Bash(head *)", "Bash(tail *)", "Bash(more *)", "Bash(less *)",
      "Bash(grep *)", "Bash(rg *)", "Bash(findstr *)", "Bash(cp *)", "Bash(copy *)",
      "PowerShell(Get-Content *)", "PowerShell(gc *)", "PowerShell(cat *)", "PowerShell(type *)",
      "PowerShell(Select-String *)", "PowerShell(Copy-Item *)", "PowerShell(copy *)"
    ]
  }
}
